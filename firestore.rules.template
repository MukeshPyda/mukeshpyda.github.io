rules_version = '2';

// Firestore security rules for hmcyberacademy.com courses.
//
// This template is committed with a placeholder. The real rules (with the admin
// email filled in) are generated into firestore.rules, which is git-ignored:
//   npm run rules -- you@example.com
// Then paste firestore.rules into Firebase console > Firestore > Rules > Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn()
        && 'email' in request.auth.token
        && request.auth.token.email_verified == true;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function isAdmin() {
      return verified() && email() == '__ADMIN_EMAIL__';
    }

    function enrolled(courseId) {
      let path = /databases/$(database)/documents/enrollments/$(email());
      return verified() && exists(path) && courseId in get(path).data.courses;
    }

    // The admin page reads this (it need not exist) to find out if you are the admin.
    match /admin/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /courses/{courseId} {
      // Public catalog entry: titles, description, price and syllabus only.
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();

      // Lessons (YouTube ids), links and PDFs: enrolled learners only.
      match /private/{docId} {
        allow read: if isAdmin() || enrolled(courseId);
        allow write: if isAdmin();
      }

      match /files/{fileId} {
        allow read: if isAdmin() || enrolled(courseId);
        allow write: if isAdmin();

        match /chunks/{chunkId} {
          allow read: if isAdmin() || enrolled(courseId);
          allow write: if isAdmin();
        }
      }
    }

    // enrollments/{email} = { courses: [courseId, ...] }. Only the admin grants access.
    match /enrollments/{learner} {
      allow read: if isAdmin() || (verified() && email() == learner);
      allow write: if isAdmin();
    }

    // "Request access": a signed-in learner asks for one published course.
    match /requests/{reqId} {
      allow read: if isAdmin() || (verified() && resource.data.email == email());
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['email', 'name', 'courseId', 'createdAt'])
        && request.resource.data.email == email()
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.courseId is string
        && reqId == email() + '__' + request.resource.data.courseId
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.published == true;
      allow delete: if isAdmin() || (verified() && resource.data.email == email());
      allow update: if false;
    }

    // Each learner's own "mark done" ticks.
    match /progress/{uid}/courses/{courseId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['done'])
        && request.resource.data.done is list
        && request.resource.data.done.size() <= 2000;
    }
  }
}
